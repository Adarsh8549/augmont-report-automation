# Augmont Daily Report webapp — environment
# The webapp also reads the shared ../.env (WordPress creds live there).
# Put Canva OAuth + Brand Template config here (or in ../.env).

# --- WordPress (already in ../.env; shown here for reference) ---
# WP_SITE=https://insights.augmont.com
# WP_USERNAME=technical
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# WP_CATEGORY_ID=27

# --- Canva Connect API ---
# Create an integration at https://www.canva.com/developers/integrations/connect-api
# Set the redirect URL there to exactly match CANVA_REDIRECT_URI below.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:3000/auth/canva/callback

# Existing design to export as-is (designExport mode).
CANVA_DESIGN_ID=DAHBvlbvmHs

# Brand Template ID for fully-automated autofill mode (Canva Teams/Enterprise).
# Leave blank until you have created the Brand Template.
CANVA_BRAND_TEMPLATE_ID=

# Web server port
PORT=3000
